<Project>
  <PropertyGroup>
    <FsDocsLogoSource>https://raw.githubusercontent.com/hedgehogqa/fsharp-hedgehog/master/img/hedgehog-logo.png</FsDocsLogoSource>
    <FsDocsLogoLink>https://hedgehog.qa</FsDocsLogoLink>
    <FsDocsLicenseLink>https://github.com/hedgehogqa/fsharp-hedgehog/blob/master/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/hedgehogqa/fsharp-hedgehog/blob/master/CHANGELOG.md</FsDocsReleaseNotesLink>
    <FsDocsNavbarPosition>fixed-right</FsDocsNavbarPosition>
    <FsDocsWarnOnMissingDocs>false</FsDocsWarnOnMissingDocs>
    <FsDocsTheme>default</FsDocsTheme>
  </PropertyGroup>
  <!-- The packages require FSharp.Core 10.1.402, the version of the .NET 10 SDK, on every machine that packs them -->
  <PropertyGroup>
    <FSharpCoreImplicitPackageVersion>10.1.402</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
</Project>
